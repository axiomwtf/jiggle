project._jgl {
    target native
    name edge
}

main._c {
    #pragma GCC diagnostic ignored "-Wall"
    #include <stdio.h>
    #include <string.h>
    #include <stdlib.h>

    /* The hostile string: a space, a double quote, a percent sign and a
       backslash. It has to arrive byte-identical in every language. */
    const char *hostile = "a b\"c%d\\e";

    /* Java: zero args, int, bool, string, four args, big long */
    extern double jZero(void);
    extern double jInt(long n);
    extern double jBool(int flag);
    extern char *jStr(const char *s);
    extern double jMany(double a, double b, long c, const char *d);
    extern long jBig(void);

    /* C#: long return, string return, mixed args, big long */
    extern long cCount(const char *s);
    extern char *cEcho(const char *s);
    extern double cMany(double a, long b, long c);
    extern long cBig(void);

    /* Python: zero args, four args, string return, bool arg, length */
    extern double pZero(void);
    extern double pMany(double a, double b, long c, const char *d);
    extern char *pEcho(const char *s);
    extern double pFlag(int flag);
    extern long pLen(const char *s);

    /* Lua: zero args, string return, bool arg */
    extern double lZero(void);
    extern char *lEcho(const char *s);
    extern double lFlag(int flag);

    /* TypeScript: zero args, string return, bool arg, four args */
    extern double tZero(void);
    extern char *tEcho(const char *s);
    extern double tFlag(int flag);
    extern double tMany(double a, double b, double c, const char *d);

    /* Two TypeScript files declaring a method of the same name. The symbols
       mention the file, so they do not collide. */
    extern double ts_dupA_shared(double v);
    extern double ts_dupB_shared(double v);

    /* A method whose name is a C keyword: the symbol is jgl_int. */
    extern double jgl_int(double a);

    /* A void method: the call has to run even though nothing is read back */
    extern void pVoid(void);

    /* Two string results held at the same time: they must not alias */
    extern char *pOne(void);
    extern char *pTwo(void);

    /* A long string argument: it must not be truncated */
    extern char *pLong(const char *s);
    extern long pLongLen(const char *s);

    int main(void) {
        printf("= %g\n", jZero());
        printf("= %g\n", jInt(21));
        printf("= %g\n", jBool(1));
        printf("= %s\n", jStr(hostile));
        printf("= %g\n", jMany(1.0, 2.0, 3, "abcd"));
        printf("= %ld\n", jBig());

        printf("= %ld\n", cCount("hello"));
        printf("= %s\n", cEcho(hostile));
        printf("= %g\n", cMany(1.5, 2, 3));
        printf("= %ld\n", cBig());

        printf("= %g\n", pZero());
        printf("= %g\n", pMany(1.0, 2.0, 3, "abcd"));
        printf("= %s\n", pEcho(hostile));
        printf("= %g\n", pFlag(1));
        printf("= %g\n", pFlag(0));
        printf("= %ld\n", pLen("a\nb"));

        printf("= %g\n", lZero());
        printf("= %s\n", lEcho(hostile));
        printf("= %g\n", lFlag(1));
        printf("= %g\n", lFlag(0));

        printf("= %g\n", tZero());
        printf("= %s\n", tEcho(hostile));
        printf("= %g\n", tFlag(1));
        printf("= %g\n", tFlag(0));
        printf("= %g\n", tMany(1.0, 2.0, 3.0, "abcd"));

        printf("= %g\n", ts_dupA_shared(10.0));
        printf("= %g\n", ts_dupB_shared(10.0));

        printf("= %g\n", jgl_int(7.0));

        /* A void method runs, and its output does not corrupt the results */
        pVoid();

        /* Two string results held at the same time */
        const char *one = pOne();
        const char *two = pTwo();
        printf("= %s\n", one);
        printf("= %s\n", two);

        /* A long string argument survives whole */
        char *big = (char *)malloc(10001);
        memset(big, 'x', 10000);
        big[10000] = '\0';
        char *r = pLong(big);
        printf("= %zu\n", strlen(r));
        printf("= %ld\n", pLongLen(big));
        free(big);
        return 0;
    }}

edge._java {
    package com.example.edge;

    public class Edge {
        public static double jZero() {
            return 42.0;
        }

        public static double jInt(long n) {
            return n * 2.0;
        }

        public static double jBool(boolean flag) {
            return flag ? 1.0 : 0.0;
        }

        public static String jStr(String s) {
            return s;
        }

        public static double jMany(double a, double b, long c, String d) {
            return a + b + c + d.length();
        }

        public static long jBig() {
            return 5000000000L;
        }
    }}

edge._cs {
    using System;

    public class EdgeCs {
        public static long cCount(string s) {
            return s.Length;
        }

        public static string cEcho(string s) {
            return s;
        }

        public static double cMany(double a, long b, int c) {
            return a + b + c;
        }

        public static long cBig() {
            return 5000000000L;
        }
    }}

edge._py {
    import sys

    def pZero():
        return 42.0

    def pMany(a: float, b: float, c: int, d: str) -> float:
        return a + b + c + len(d)

    def pEcho(s: str) -> str:
        return s

    def pFlag(flag: bool) -> float:
        return 1.0 if flag else 0.0

    def pLen(s: str) -> int:
        return len(s)

    def pVoid() -> None:
        pass

    def pOne() -> str:
        return "FIRST"

    def pTwo() -> str:
        return "SECOND"

    def pLong(s: str) -> str:
        return s

    def pLongLen(s: str) -> int:
        return len(s)}

edge._lua {
    ---@return number
    function lZero()
        return 42.0
    end

    ---@param s string
    ---@return string
    function lEcho(s)
        return s
    end

    ---@param flag boolean
    ---@return number
    function lFlag(flag)
        if flag then return 1.0 else return 0.0 end
    end}

edge._ts {
    export function tZero(): number {
        return 42.0;
    }

    export function tEcho(s: string): string {
        return s;
    }

    export function tFlag(flag: boolean): number {
        return flag ? 1.0 : 0.0;
    }

    export function tMany(a: number, b: number, c: number, d: string): number {
        return a + b + c + d.length;
    }}

dupA._ts {
    export function shared(v: number): number {
        return v + 1.0;
    }}

dupB._ts {
    export function shared(v: number): number {
        return v + 2.0;
    }}

kw._ts {
    export function int(x: number): number {
        return x;
    }}

notes._py {
    # This file declares no method at all: it must not produce a broken stub.
    VALUE = 1}

